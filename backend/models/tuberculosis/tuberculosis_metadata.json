    "prediction_threshold": 0.5,
    "gradcam_layer": "top_conv",
    "test_metrics": {
        "accuracy": 0.9905,
        "precision": 0.9806,
        "recall": 0.9619,
        "specificity": 0.9962,
        "f1_score": 0.9712,
        "roc_auc": 0.9974
    },
    "confusion_matrix": [
        [
            523,
            2
        ],
        [
            4,
            101
        ]
    ],
    "dataset": {
        "name": "TB Chest Radiography Database",
        "normal_images": 3500,
        "tuberculosis_images": 700,
        "test_images": 630,
        "split_method": "Stratified image-level split",
        "random_state": 42
    },
    "disclaimer": "Academic research prototype. Not intended for clinical diagnosis or replacement of professional medical evaluation."
